{
  "name": "prooflayer",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "AI says it's fixed. ProofLayer proves it.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "worker": "node --env-file-if-exists=.env.local --disable-warning=ExperimentalWarning worker/index.ts",
    "setup": "bash scripts/setup.sh",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.ts",
    "demo:init": "bash scripts/demo-init.sh",
    "demo:export": "node --disable-warning=ExperimentalWarning scripts/export-recorded.ts",
    "demo:snapshot": "PROOFLAYER_PUBLIC_DEMO=false node --disable-warning=ExperimentalWarning scripts/build-snapshot.ts",
    "build:public": "npm run demo:init && npm run demo:snapshot && PROOFLAYER_PUBLIC_DEMO=true next build",
    "start:public": "PROOFLAYER_PUBLIC_DEMO=true next start -p 3000"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "lucide-react": "1.77.0",
    "motion": "^13.3.0",
    "next": "16.4.6",
    "playwright-core": "^1.56.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.15.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0"
  }
}
