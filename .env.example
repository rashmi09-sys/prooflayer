# ProofLayer private installation. Copy to .env.local and fill in.
# Placeholders only: never commit real values. The public read-only demo needs none of these.

# Required to sign in at /operator.
PROOFLAYER_ACCESS_CODE=change-me-at-least-12-characters
# HMAC key for session cookies, at least 32 characters: openssl rand -hex 32
PROOFLAYER_SESSION_SECRET=replace-with-output-of-openssl-rand-hex-32

# Mode. true = public read-only demo, false = private. Unset: public on Vercel, private elsewhere.
# PROOFLAYER_PUBLIC_DEMO=false
# PROOFLAYER_OPERATOR_EMAIL=operator@prooflayer.local
# Local http only: allow session cookies without Secure.
# PROOFLAYER_INSECURE_COOKIES=false

# Optional: AI explanations of failed checks. They never change a verdict.
# ANTHROPIC_API_KEY=
# PROOFLAYER_ANTHROPIC_MODEL=
# PROOFLAYER_ANTHROPIC_BASE_URL=https://api.anthropic.com

# Optional: one allowlisted GitHub repository, read with a read-only token.
# PROOFLAYER_GITHUB_REPOSITORY=owner/name
# PROOFLAYER_GITHUB_TOKEN=

# Optional: worker, sandbox and limits (defaults shown).
# PROOFLAYER_DATA_DIR=.data
# PROOFLAYER_CHROMIUM_PATH=
# PROOFLAYER_RUNNER_IMAGE=prooflayer-runner:node22
# PROOFLAYER_RUNNER_MEMORY=2g
# PROOFLAYER_RUNNER_CPUS=2
# PROOFLAYER_RUNNER_PIDS=512
# PROOFLAYER_INSTALL_TIMEOUT_MS=240000
# PROOFLAYER_CHECK_TIMEOUT_MS=180000
# PROOFLAYER_MAX_CAPTURE_BYTES=4000000
# PROOFLAYER_MAX_STORED_CHARS=64000
# PROOFLAYER_KEEP_WORKDIRS=
